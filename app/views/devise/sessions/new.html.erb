<% content_for :title, "Log in | JobEasy" %>

<section class="auth-page">
  <div class="auth-card">
    <header class="auth-card__header">
      <h1>Log in to JobEasy</h1>
      <p>Pick up your job search right where you left off.</p>
    </header>

    <%= simple_form_for(resource,
                        as: resource_name,
                        url: session_path(resource_name),
                        html: { class: "auth-form" }) do |f| %>
      <div class="auth-form__fields">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: false,
                    placeholder: "Enter your email",
                    input_html: { autocomplete: "email", aria: { label: "Email address" } } %>

        <%= f.input :password,
                    required: true,
                    label: false,
                    placeholder: "Enter your password",
                    input_html: { autocomplete: "current-password", aria: { label: "Password" } } %>
      </div>

      <div class="auth-form__options">
        <%= f.input :remember_me, as: :boolean if devise_mapping.rememberable? %>

        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot password?", new_password_path(resource_name) %>
        <% end %>
      </div>

      <%= f.button :submit, "Log in", class: "auth-form__submit" %>
    <% end %>

    <% if devise_mapping.registerable? %>
      <p class="auth-card__footer">
        New to JobEasy?
        <%= link_to "Create an account", new_registration_path(resource_name) %>
      </p>
    <% end %>
  </div>
</section>
