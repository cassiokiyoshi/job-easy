<% content_for :title, "Reset password | JobEasy" %>

<section class="auth-page">
  <div class="auth-card">
    <header class="auth-card__header">
      <h1>Forgot your password?</h1>
      <p>Enter your email and we'll send you instructions to reset it.</p>
    </header>

    <%= simple_form_for(resource,
                        as: resource_name,
                        url: password_path(resource_name),
                        html: { method: :post, class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="auth-form__fields">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: false,
                    placeholder: "Enter your email",
                    input_html: { autocomplete: "email", aria: { label: "Email address" } } %>
      </div>

      <%= f.button :submit, "Send reset instructions", class: "auth-form__submit" %>
    <% end %>

    <p class="auth-card__footer">
      Remembered your password?
      <%= link_to "Back to login", new_session_path(resource_name) %>
    </p>
  </div>
</section>
