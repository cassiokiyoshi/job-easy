<% content_for :title, "Create account | JobEasy" %>

<section class="auth-page">
  <div class="auth-card">
    <header class="auth-card__header">
      <h1>Create your account</h1>
      <p>Organize your job search and keep every opportunity on track.</p>
    </header>

    <%= simple_form_for(resource,
                        as: resource_name,
                        url: registration_path(resource_name),
                        html: { class: "auth-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="auth-form__fields">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: false,
                    placeholder: "Enter your email",
                    input_html: { autocomplete: "email", aria: { label: "Email address" } } %>
        <%= f.input :password,
                    required: true,
                    label: false,
                    hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                    placeholder: "Create a password",
                    input_html: { autocomplete: "new-password", aria: { label: "Password" } } %>
        <%= f.input :password_confirmation,
                    required: true,
                    label: false,
                    placeholder: "Confirm password",
                    input_html: { autocomplete: "new-password", aria: { label: "Confirm password" } } %>
      </div>

      <%= f.button :submit, "Create account", class: "auth-form__submit" %>
    <% end %>

    <p class="auth-card__footer">
      Already have an account?
      <%= link_to "Log in", new_session_path(resource_name) %>
    </p>
  </div>
</section>
