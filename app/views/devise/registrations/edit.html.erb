<% content_for :title, "Settings | JobEasy" %>

<section class="settings-page">
  <header class="settings-page__header">
    <div>
      <h1>Account settings</h1>
      <p>Update your email address or change your password.</p>
    </div>
  </header>

  <div class="settings-card">
    <%= simple_form_for(resource,
                        as: resource_name,
                        url: registration_path(resource_name),
                        html: { method: :put, class: "settings-form" }) do |f| %>
      <%= f.error_notification %>

      <div class="settings-form__section">
        <h2>Email</h2>
        <p>We'll use this address for account notifications.</p>

        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    label: "Email address",
                    input_html: { autocomplete: "email" } %>

        <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <p class="settings-form__notice">
            Confirmation pending for <strong><%= resource.unconfirmed_email %></strong>.
          </p>
        <% end %>
      </div>

      <div class="settings-form__section">
        <h2>Change password</h2>
        <p>Leave these fields blank if you want to keep your current password.</p>

        <div class="settings-form__grid">
          <%= f.input :password,
                      label: "New password",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
          <%= f.input :password_confirmation,
                      label: "Confirm new password",
                      required: false,
                      input_html: { autocomplete: "new-password" } %>
        </div>
      </div>

      <div class="settings-form__section settings-form__section--confirmation">
        <%= f.input :current_password,
                    label: "Current password",
                    hint: "Required to save any account changes",
                    required: true,
                    input_html: { autocomplete: "current-password" } %>
      </div>

      <div class="settings-form__actions">
        <%= f.button :submit, "Save changes", class: "settings-form__submit" %>
      </div>
    <% end %>
  </div>

  <div class="settings-card settings-card--danger">
    <div>
      <h2>Delete account</h2>
      <p>Permanently remove your account and all associated data.</p>
    </div>

    <%= button_to "Delete my account",
                  registration_path(resource_name),
                  method: :delete,
                  class: "settings-card__delete",
                  form_class: "settings-card__delete-form",
                  data: { turbo_confirm: "Are you sure? This action cannot be undone." } %>
  </div>
</section>
