<% content_for :title, "Interview Simulation | JobEasy" %>

<div class="interview-prep-page">
  <p class="interview-prep-page__eyebrow">Interview simulation</p>

  <main class="interview-prep-index">
    <header class="interview-prep-index__header">
      <h1>Pick an application to prep for</h1>
      <p class="interview-prep-index__lead">
        Work through your career-change story, a project walkthrough, your interest,
        the experience gap, and what to ask about training.
      </p>
    </header>

    <% if @job_applications.any? %>
      <div class="interview-prep-index__groups">
        <% JobApplication.statuses.each do |status, label| %>
          <% applications = @job_applications.select { |application| application.status == label } %>
          <% next if applications.empty? %>

          <section class="interview-prep-index__group interview-prep-index__group--<%= status %>">
            <header class="interview-prep-index__group-header">
              <h2><%= label %></h2>
              <span><%= applications.size %></span>
            </header>

            <ul class="interview-prep-index__list">
              <% applications.each do |application| %>
                <% opening = application.job_opening %>
                <li>
                  <%= link_to job_application_interview_session_path(application),
                              class: "interview-prep-index__card" do %>
                    <span class="dashboard-job__mark" style="<%= application.job_opening.company.logo.attached? ? "background-image: url(#{cl_image_path(application.job_opening.company.logo.key, secure: true)})" : "background-color: rgba(0, 61, 150, 0.09)" %>"></span>
                    <div class="interview-prep-index__card-body">
                      <h3><%= opening.title %></h3>
                      <p><%= opening.company.name %></p>
                    </div>
                    <span class="interview-prep-index__card-cta" aria-hidden="true">&rarr;</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </div>
    <% else %>
      <p class="interview-prep-index__empty">
        You don't have any applications yet.
        <%= link_to "Browse the job board", job_openings_path %>.
      </p>
    <% end %>
  </main>
</div>
