<section id="<%= dom_id(chat, :interview_chat) %>"
         class="application-chat"
         aria-label="Interview chat">
  <% if chat.persisted? %>
    <%= turbo_stream_from [chat, :messages] %>
  <% end %>

  <%= render "interview_prep/sessions/messages", chat: chat %>

  <%= form_with model: message,
                url: job_application_interview_session_messages_path(job_application),
                class: "application-chat__form",
                data: {
                  controller: "chat-form",
                  action: "keydown->chat-form#submitOnEnter turbo:submit-end->chat-form#reset"
                } do |form| %>
    <% if message.errors.any? %>
      <p class="application-chat__error">
        <%= message.errors.full_messages.to_sentence %>
      </p>
    <% end %>

    <%= form.label :content, "Your answer", class: "visually-hidden" %>
    <div class="application-chat__composer">
      <%= form.text_area :content,
                        placeholder: "Type your answer…",
                        rows: 3,
                        required: true %>

      <%= form.submit "Send", data: { turbo_submits_with: "Sending…" } %>
    </div>
  <% end %>
</section>
