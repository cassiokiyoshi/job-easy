<aside class="sidebar" id="sidebar" data-controller="sidebar">
  <div class="sidebar__header">
    <%= link_to root_path, class: "sidebar__brand" do %>
      <span class="sidebar__brand-full">JobEasy</span>
    <% end %>

    <button
      class="sidebar__brand-short"
      type="button"
      data-action="click->sidebar#expand"
      aria-label="Expand sidebar"
    >J</button>

    <button
      class="sidebar__toggle"
      id="sidebar-toggle"
      data-sidebar-target="toggle"
      data-action="click->sidebar#toggle"
      type="button"
      aria-label="Collapse sidebar"
      aria-expanded="true"
      aria-controls="sidebar"
    >
      <span aria-hidden="true">‹</span>
    </button>
  </div>

  <div class="sidebar__user">
    <span class="sidebar__avatar" aria-hidden="true">U</span>

    <div class="sidebar__user-information">
      <span class="sidebar__username">Username</span>
      <span class="sidebar__account-label"></span>
    </div>
  </div>

  <nav class="sidebar__navigation" aria-label="Application navigation">
    <%= link_to dashboard_path,
        class: class_names(
          "sidebar__link",
          "sidebar__link--active": current_page?(dashboard_path)
        ) do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="3.5" y="3.5" width="6.5" height="6.5" rx="1.5" />
          <rect x="14" y="3.5" width="6.5" height="6.5" rx="1.5" />
          <rect x="3.5" y="14" width="6.5" height="6.5" rx="1.5" />
          <rect x="14" y="14" width="6.5" height="6.5" rx="1.5" />
        </svg>
      </span>

      <span class="sidebar__label">Dashboard</span>
    <% end %>

    <%= link_to job_applications_path,
        class: class_names(
          "sidebar__link",
          "sidebar__link--active": request.path.start_with?(job_applications_path)
        ) do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <path d="M9 5H6.5A2.5 2.5 0 0 0 4 7.5v11A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 17.5 5H15" />
          <rect x="9" y="3" width="6" height="4" rx="1.5" />
          <path d="M8 12h8M8 16h6" />
        </svg>
      </span>

      <span class="sidebar__label">My applications</span>
    <% end %>

    <%= link_to tasks_path,
        class: class_names(
          "sidebar__link",
          "sidebar__link--active": request.path == tasks_path
        ) do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="9" />
          <path d="m8 12 2.5 2.5L16.5 9" />
        </svg>
      </span>

      <span class="sidebar__label">Daily tasks</span>
    <% end %>

    <%= link_to job_openings_path,
        class: class_names(
          "sidebar__link",
          "sidebar__link--active": request.path.start_with?(job_openings_path)
        ) do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <rect x="3" y="6.5" width="18" height="13.5" rx="2.5" />
          <path d="M9 6.5V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v1.5M3 11h18M9.5 11v2h5v-2" />
        </svg>
      </span>

      <span class="sidebar__label">Job list</span>
    <% end %>
  </nav>

  <div class="sidebar__footer">
    <%= link_to settings_path,
        class: class_names(
          "sidebar__link",
          "sidebar__link--active": request.path == "/settings"
        ),
        title: "Settings" do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.86 2.86-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.55v-.1A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.86-2.86.06-.06A1.7 1.7 0 0 0 4.1 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H2.3V9.55h.1A1.7 1.7 0 0 0 4.1 8.5a1.7 1.7 0 0 0-.34-1.88l-.06-.06L6.56 3.7l.06.06A1.7 1.7 0 0 0 8.5 4.1a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1v-.1h4.05v.1a1.7 1.7 0 0 0 1.05 1.7 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.86 2.86-.06.06A1.7 1.7 0 0 0 19.4 8.5a1.7 1.7 0 0 0 .6 1 1.7 1.7 0 0 0 1.1.4h.1v4.05h-.1A1.7 1.7 0 0 0 19.4 15Z" />
        </svg>
      </span>

      <span class="sidebar__label">Settings</span>
    <% end %>

    <%= button_to destroy_user_session_path,
        method: :delete,
        class: "sidebar__link sidebar__logout",
        form_class: "sidebar__logout-form",
        title: "Log out",
        aria: { label: "Log out" } do %>
      <span class="sidebar__icon" aria-hidden="true">
        <svg
          class="sidebar__logout-icon"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
        >
          <path
            d="M10 5H6.5A2.5 2.5 0 0 0 4 7.5v9A2.5 2.5 0 0 0 6.5 19H10"
          />

          <path
            d="M14 8l4 4-4 4M18 12H9"
          />
        </svg>
      </span>

      <span class="sidebar__label">Log out</span>
    <% end %>
  </div>
</aside>
