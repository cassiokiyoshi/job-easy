<div class="container">

  <div class="title my-5">
    <p class="my-0"><%= @job_application.job_opening.company.name %></p>
    <h1 class="my-0"><%= @job_application.job_opening.title %> Application</h1>
    <p><%= @job_application.status %></p>
  </div>

  <div class="d-flex">
    <div class="application-status col-8 mx-2 card bg-white text-dark border border-dark">
      <div class="card-body">
        <h4>Application Status</h4>
        <%= simple_form_for @job_application, method: :patch do |f| %>
          <%= f.select :status, collection: JobApplication.statuses.values %>
          <%= f.submit "Submit" %>
        <% end %>
      </div>
    </div>

    <div class="job-details-wrapper col-4 mx-2">
      <div class="job-details card text-dark border border-dark">
        <div class="card-body">
          <h4>Job Details</h4>
          <p><strong>Company:</strong> <%= @job_application.job_opening.company.name %></p>
          <p><strong>Posted on:</strong> <%= @job_application.job_opening.created_at.strftime("%B %d, %Y") %></p>
          <p><strong>Applied on:</strong> <%= @job_application.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>

      <%= link_to "Check Details", job_opening_path(@job_application.job_opening), class: "job-application-button" %>

      <div class="job-application-buttons mt-2" data-controller="auto-submit">
        <% if @job_application.resume.id.present? %>
          <div class="mt-2">
              <%= link_to "Go to Resume", edit_resume_path(@job_application.resume), class: "job-application-button" %>
          </div>
          <div class="upload-button mt-2">
            <%= simple_form_for @resume, url: job_application_resumes_path(@job_application), method: :post, data: {auto_submit_target: "form"} do |f| %>
              <%= f.label :cv_file, "Add a new resume", class: "job-application-button", for: "resume_cv_file" %>
              <%= f.file_field :cv_file, id: "resume_cv_file", class: "d-none", data: { action: "change->auto-submit#submit" } %>
            <% end %>
          </div>
        <% else %>
            <div class="upload-button mt-2">
            <%= simple_form_for @resume, url: job_application_resumes_path(@job_application), method: :post, data: {auto_submit_target: "form"} do |f| %>
              <%= f.label :cv_file, "Add a resume", class: "job-application-button", for: "resume_cv_file" %>
              <%= f.file_field :cv_file, id: "resume_cv_file", class: "d-none", data: { action: "change->auto-submit#submit" } %>
            <% end %>
        <% end %>
      </div>
    </div>
  </div>

</div>


<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>


  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

<div class="card bg-white text-dark border border-dark my-3">
  <div class="card-body">
    <h4>AI Tasks</h4>

    <p>
      Generate and save tasks based on the application status and job details.
    </p>

    <%= button_to "Generate and save tasks",
                  suggest_tasks_job_application_path(@job_application),
                  method: :post,
                  class: "btn btn-primary",
                  data: {
                    turbo: false,
                    turbo_confirm: "Generate and save all suggested tasks?"
                  } %>
  </div>
</div>
