<div class="container">

  <div class="title my-5">
    <p class="my-0"><%= @job_application.job_opening.company.name %></p>
    <h1 class="my-0"><%= @job_application.job_opening.title %> Application</h1>
    <p><%= @job_application.status %></p>
  </div>

 <div class="d-flex">
  <div class="application-status col-8 mx-2 card bg-white text-dark border-white">
    <div class="card-body">
      <h4>Application Status</h4>

      <div class="status-bar d-flex justify-content-between my-4">
        <% %w[saved applied interviewed offered accepted].each do |step| %>
          <%= button_to job_application_path(@job_application), method: :patch, params: { job_application: { status: step } }, class: "status-step-btn" do %>
            <div class="status-step text-center">
              <div class="status-dot"></div>
              <p class="status-label"><%= step.capitalize %></p>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>


    <div class="job-details-wrapper col-4 mx-2">
      <div class="job-details card text-dark border border-white">
        <div class="card-body">
          <h4>Job Details</h4>
          <p><strong>Company:</strong> <%= @job_application.job_opening.company.name %></p>
          <p><strong>Posted on:</strong> <%= @job_application.job_opening.created_at.strftime("%B %d, %Y") %></p>
          <p><strong>Applied on:</strong> <%= @job_application.created_at.strftime("%B %d, %Y") %></p>
        </div>
      </div>

      <%= link_to "Check Details", job_opening_path(@job_application.job_opening), class: "btn-check-details" %>
      <div class="upload-button my-3">
      <%= simple_form_for @resume, url: job_application_resumes_path(@job_application), method: :post do |f| %>
        <%= f.input :cv_file, as: :file, label: false, input_html: { id: "cv-file-input", style: "display:none;" } %>
    <!-- <label for="cv-file-input" class="btn-upload-button">Choose File</label> -->
        <%= f.button :submit, "Upload resume", class: "btn-upload-button" %>
      <% end %>
      </div>
    </div>
  </div>
</div>


<% if flash[:alert] %>
  <div class="alert alert-danger"><%= flash[:alert] %></div>
<% end %>


  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

<div class="card small-white text-dark border-white my-3">
  <div class="card-body">
    <h4>AI Tasks</h4>

    <p>
      Generate and save tasks based on the application status and job details.
    </p>

    <%= button_to "Generate and save tasks",
                  suggest_tasks_job_application_path(@job_application),
                  method: :post,
                  class: "btn btn-primary",
                  data: {
                    turbo: false,
                    turbo_confirm: "Generate and save all suggested tasks?"
                  } %>
  </div>
</div>
