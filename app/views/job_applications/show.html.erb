<% opening = @job_application.job_opening %>
<% company = opening.company %>
<% stages = %w[Saved Applied Interviewed Offered Accepted Rejected] %>
<% current_stage = stages.index(@job_application.status) unless @job_application.status == "Rejected" %>
<% interviews = @job_application.interview_schedule.sort %>
<% show_interview_card = @job_application.status.in?(%w[Applied Interviewed Offered Accepted]) %>
<% content_for :title, "#{opening.title} application | JobEasy" %>

<div class="application-show-page"
     data-controller="chat-panel"
     data-chat-panel-open-value="<%= params[:chat] == "open" %>">
  <%= link_to job_applications_path, class: "page-back-link", aria: { label: "Back to applications" } do %>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" /><path d="M9 12h10" /></svg>
    <span>Back to applications</span>
  <% end %>

  <% if flash[:alert] %>
    <div class="alert alert-danger"><%= flash[:alert] %></div>
  <% end %>

  <div class="application-show-layout">
    <main class="application-show-main">
      <section class="application-show-card application-pipeline-card">
        <header class="application-pipeline-card__header">
          <div class="application-show-header__title">
            <p><%= company.name %></p>
            <h1><%= opening.title %></h1>
          </div>
          <span class="application-status-pill application-status-pill--<%= @job_application.status.downcase %>"><%= @job_application.status %></span>
        </header>
        <h2>Application status</h2>
        <div class="application-pipeline" aria-label="Application pipeline">
          <% stages.each_with_index do |stage, index| %>
            <% reached = stage == "Rejected" ? @job_application.status == "Rejected" : current_stage.present? && index <= current_stage %>
            <% active = stage == @job_application.status %>
            <%= button_to job_application_path(@job_application), method: :patch,
                          params: { job_application: { status: stage } },
                          class: class_names("application-pipeline__step", "application-pipeline__step--rejected": stage == "Rejected", "is-reached": reached, "is-active": active),
                          aria: { label: "Change application status to #{stage}", current: ("step" if active) } do %>
              <span class="application-pipeline__track" aria-hidden="true"></span>
              <span class="application-pipeline__dot" aria-hidden="true"></span>
              <span class="application-pipeline__label"><%= stage %></span>
            <% end %>
          <% end %>
        </div>
        <% if @job_application.status == "Rejected" %>
          <p class="application-pipeline__notice">This application has been marked as rejected.</p>
        <% end %>
      </section>

      <% if show_interview_card %>
        <section class="application-show-card application-interview-card">
          <header class="application-interview-card__header">
            <h2>Interviews</h2>
            <p><%= pluralize(interviews.size, "interview") %> scheduled</p>
          </header>

          <% if interviews.any? %>
            <ul class="application-interview-list">
              <% interviews.each do |interview_at| %>
                <li class="application-interview-list__item">
                  <time datetime="<%= interview_at.iso8601 %>"><%= interview_at.strftime("%B %-d, %Y at %-I:%M %p") %></time>
                  <span class="application-interview-list__badge application-interview-list__badge--<%= interview_at.past? ? "past" : "upcoming" %>">
                    <%= interview_at.past? ? "Completed" : "Upcoming" %>
                  </span>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="application-interview-card__empty">No interviews scheduled yet. Add the date and time below.</p>
          <% end %>

          <%= form_with url: schedule_interview_job_application_path(@job_application), method: :post, class: "application-interview-form" do |form| %>
            <div class="application-interview-form__field">
              <%= form.label :interview_at, "Interview date & time" %>
              <%= form.datetime_field :interview_at, required: true,
                                      value: Time.current.strftime("%Y-%m-%dT%H:%M") %>
            </div>
            <%= form.submit "Schedule interview" %>
          <% end %>
        </section>
      <% end %>

      <section class="application-show-card application-timeline-card">
        <h2>Application activity</h2>
        <div class="application-timeline">
          <% interviews.reverse_each do |interview_at| %>
            <article class="application-timeline__event">
              <span class="application-timeline__marker" aria-hidden="true"></span>
              <time datetime="<%= interview_at.iso8601 %>"><%= interview_at.strftime("%b %-d, %Y") %></time>
              <h3>Interview <%= interview_at.past? ? "completed" : "scheduled" %></h3>
              <p><%= interview_at.past? ? "This interview round has passed." : "You have an upcoming interview round." %></p>
            </article>
          <% end %>
          <% if @job_application.updated_at > @job_application.created_at + 1.second %>
            <article class="application-timeline__event">
              <span class="application-timeline__marker" aria-hidden="true"></span>
              <time datetime="<%= @job_application.updated_at.iso8601 %>"><%= @job_application.updated_at.strftime("%b %-d, %Y") %></time>
              <h3>Status changed to <%= @job_application.status.downcase %></h3>
              <p>Your application and suggested tasks were updated.</p>
            </article>
          <% end %>
          <article class="application-timeline__event">
            <span class="application-timeline__marker" aria-hidden="true"></span>
            <time datetime="<%= @job_application.created_at.iso8601 %>"><%= @job_application.created_at.strftime("%b %-d, %Y") %></time>
            <h3>Application saved</h3>
            <p>You added this opening to your application pipeline.</p>
          </article>
        </div>
      </section>

      <section class="application-show-card application-task-card">
        <header class="application-task-card__header">
          <div><h2>My tasks</h2><p><%= pluralize(@job_application.tasks.reject(&:completed?).size, "task") %> remaining</p></div>
          <%= button_to "Refresh tasks", suggest_tasks_job_application_path(@job_application), method: :post,
                        class: "application-task-card__refresh",
                        data: { turbo: false, turbo_confirm: "Generate and save all suggested tasks?" } %>
        </header>
        <div class="application-task-card__list">
          <% if @job_application.tasks.any? %>
            <% @job_application.tasks.order(:position, :created_at).each do |task| %>
              <%= render "tasks/task", task: task %>
            <% end %>
          <% else %>
            <p class="application-task-card__empty">No tasks yet. Refresh tasks to create suggestions for this application.</p>
          <% end %>
        </div>
      </section>
    </main>

    <aside class="application-show-sidebar">
      <section class="application-details-card">
        <h2>Job details</h2>
        <dl>
          <div><dt>Company</dt><dd><%= @company.name %></dd></div>
          <div><dt>Location</dt><dd class="<%= "is-unavailable" if @job_opening.location.blank? %>"><%= @job_opening.location.presence || "Not available" %></dd></div>
          <div><dt>Salary</dt><dd class="<%= "is-unavailable" if @job_opening.salary.blank? %>"><%= @job_opening.salary.presence || "Not available" %></dd></div>
          <div><dt>Deadline</dt><dd class="<%= "is-unavailable" if @job_opening.deadline.blank? %>"><%= @job_opening.deadline&.strftime("%B %-d, %Y") || "Not available" %></dd></div>
          <div><dt>Applied on</dt><dd><%= @job_application.created_at.strftime("%B %-d, %Y") %></dd></div>
          <div><dt>Job URL</dt><dd class="<%= "is-unavailable" if @job_opening.job_url.blank? %>">
            <% if @job_opening.job_url.present? %><%= link_to "View job page", @job_opening.job_url, target: "_blank", rel: "noopener noreferrer" %><% else %>Not available<% end %>
          </dd></div>
          <div><dt>Source</dt><dd class="<%= "is-unavailable" if @job_opening.source_url.blank? %>">
            <% if @job_opening.source_url.present? %><%= link_to "View source", @job_opening.source_url, target: "_blank", rel: "noopener noreferrer" %><% else %>Not available<% end %>
          </dd></div>
        </dl>

        <% if @job_application.verdict.present? %>
          <div class="application-verdict application-verdict--ready">
            <p class="application-verdict__label">Your fit</p>
            <%= simple_format(@job_application.verdict, {}, wrapper_tag: "p") %>
          </div>
        <% elsif @default_resume.present? %>
          <div class="application-verdict application-verdict--placeholder">
            <p class="application-verdict__label">Your fit</p>
            <p>Checking your fit for this role — refresh in a moment.</p>
          </div>
        <% else %>
          <div class="application-verdict application-verdict--placeholder">
            <p class="application-verdict__label">Your fit</p>
            <p>Set a default resume to see whether this role is a good fit.</p>
          </div>
        <% end %>

        <div class="application-details-actions">
          <%= link_to "View opening details", job_opening_path(opening), class: "application-show-button application-show-button--primary" %>
          <% unless @job_application.rejected? %>
            <% if @job_application.resume.persisted? %>
              <%= link_to "Review resume", edit_resume_path(@job_application.resume), class: "application-show-button application-show-button--secondary" %>
              <button type="button" class="application-show-button application-show-button--secondary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                Add a new Resume
              </button>
            <% else %>
              <button type="button" class="application-show-button application-show-button--secondary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                Add a Resume
              </button>
            <% end %>
          <% end %>
          <button type="button"
                  class="application-show-button application-show-button--chat"
                  aria-controls="application-chat-panel"
                  aria-expanded="false"
                  data-chat-panel-target="trigger"
                  data-action="chat-panel#open">
            Chat with JobEasy
          </button>
          <% if @job_application.rejected? %>
            <%= button_to "Delete application",
                          job_application_path(@job_application),
                          method: :delete,
                          class: "application-show-button application-show-button--danger",
                          form: { data: { turbo_confirm: "Delete this application permanently? This cannot be undone." } } %>
          <% end %>
        </div>
      </section>
    </aside>
  </div>

  <div class="application-chat-backdrop"
       hidden
       aria-hidden="true"
       data-chat-panel-target="backdrop"
       data-action="click->chat-panel#close">
  </div>

  <aside id="application-chat-panel"
         class="application-chat-panel"
         hidden
         role="dialog"
         aria-modal="true"
         aria-label="Application chat"
         data-controller="panel-resize"
         data-chat-panel-target="panel">
    <div class="application-chat-panel__resize-handle"
         role="separator"
         aria-label="Resize chat panel"
         aria-orientation="vertical"
         tabindex="0"
         data-action="pointerdown->panel-resize#start keydown->panel-resize#resizeWithKeyboard">
    </div>

    <button type="button"
            class="application-chat-panel__close"
            aria-label="Close chat"
            data-chat-panel-target="closeButton"
            data-action="chat-panel#close">
      &times;
    </button>

    <%= render "chats/chat",
               job_application: @job_application,
               chat: @chat,
               message: @message,
               show_full_page_link: true,
               return_to_application: true %>
  </aside>
</div>

<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true" data-controller="auto-submit">
  <div class="modal-dialog">
  <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">⚠️<strong>IMPORTANT</strong> Before You Upload</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        This resume will be processed by AI to help analyze and suggest improvements for you. Please review your file and remove any sensitive personal information (such as your full name,
        phone number, email address, or home address) before uploading.<br><br>
        <strong>By clicking "Upload Resume," you consent to having your resume stored in this app and processed by AI on your behalf</strong>
         <%= simple_form_for @resume, url: job_application_resumes_path(@job_application), method: :post, data: { auto_submit_target: "form" } do |form| %>
              <%= form.label :cv_file, "Upload resume", class: "btn btn-primary upload-resume-btn ", for: "resume_cv_file" %>
              <%= form.file_field :cv_file, id: "resume_cv_file", class: "d-none", data: { action: "change->auto-submit#submit" } %>
            <% end %>
      </div>
    </div>
  </div>
</div>
