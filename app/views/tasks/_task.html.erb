<div id="<%= dom_id(task) %>"
     class="<%= class_names("task-row", "task-row--completed": task.completed?) %>">
  <%= form_with model: task,
                url: task_path(task),
                method: :patch,
                class: "task-row__toggle" do |form| %>
    <%= form.check_box :completed,
                       {
                         checked: task.completed?,
                         onchange: "this.setAttribute('aria-label', this.checked ? 'Mark task as incomplete' : 'Mark task as completed'); this.form.requestSubmit()",
                         class: "form-check-input",
                         aria: {
                           label: task.completed? ?
                             "Mark task as incomplete" :
                             "Mark task as completed"
                         }
                       },
                       true,
                       false %>
  <% end %>

  <div class="task-row__content">
    <p class="task-row__name"><%= task.name %></p>
  </div>

  <details class="task-row__menu" data-controller="task-menu">
    <summary class="task-row__menu-trigger" aria-label="More options for <%= task.name %>">
      <span aria-hidden="true">&hellip;</span>
    </summary>

    <div class="task-row__menu-options">
      <% if local_assigns.fetch(:chat_enabled, false) %>
        <button type="button"
                data-action="chat-panel#openForTask"
                data-task-content="<%= task.name %>">
          Chat about this task
        </button>
      <% end %>

      <%= button_to "Delete task",
                    task_path(task),
                    method: :delete,
                    class: "task-row__menu-delete",
                    form: { data: { turbo_confirm: "Delete this task?" } } %>
    </div>
  </details>
</div>
