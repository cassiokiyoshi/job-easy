<% content_for :title, "Resume editor | JobEasy" %>

<div class="resume-edit-page">
  <%= link_to job_application_path(@resume.job_application),
              class: "page-back-link",
              aria: { label: "Back to application" } do %>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" /><path d="M9 12h10" /></svg>
    <span>Back to application</span>
  <% end %>

  <p class="eyebrow">Resume editor</p>

  <div class="resume-edit-layout">
    <main class="resume-edit-main">
      <div class="row resume-workspace">
        <div class="col-12">
          <div id="onlyoffice-editor" style="width: 100%; height: 90vh;"></div>
        </div>
      </div>
    </main>

    <aside class="resume-edit-sidebar">
      <section class="application-details-card resume-actions-card" aria-label="Resume actions">
        <div class="application-details-actions">
          <%= link_to "Apply for this job",
                      job_application_path(
                        @resume.job_application,
                        job_application: { status: "Applied" }
                      ),
                      data: {
                        controller: "redirect",
                        redirect_url_value: @resume.job_application.job_opening.job_url,
                        action: "click->redirect#openUrl",
                        turbo_method: :patch
                      },
                      class: "application-show-button application-show-button--primary" %>

          <%= button_to (@resume.is_default? ? "Default resume ✓" : "Set as default resume"),
                        set_as_default_resume_path(@resume),
                        method: :patch,
                        class: "application-show-button application-show-button--secondary" %>

          <%= button_to recommendations_resume_path(@resume),
                        class: "application-show-button application-show-button--chat recommend-btn" do %>            <i class="fa-solid fa-circle-notch fa-spin" aria-hidden="true"></i>
            <span>Ask JobEasy for suggestions</span>
          <% end %>
        </div>

        <% if @advices.any? %>
          <div id="advices" class="resume-actions-card__suggestions" aria-label="Resume suggestions">
            <% @advices.each do |advice| %>
              <%= render partial: "advice", locals: { advice: advice, resume: @resume } %>
            <% end %>
          </div>
        <% end %>
      </section>
    </aside>
  </div>
</div>

<script src="<%= ONLYOFFICE_CONFIG[:server_url] %>/web-apps/apps/api/documents/api.js"></script>
<script>
  document.addEventListener("turbo:load", function () {
    const config = <%= raw @editor_config.to_json %>;
    if (typeof DocsAPI !== "undefined") {
      new DocsAPI.DocEditor("onlyoffice-editor", config);
    } else {
      document.getElementById("onlyoffice-api-script")?.addEventListener("load", function() {
        new DocsAPI.DocEditor("onlyoffice-editor", config);
      });
    }
  });
</script>
