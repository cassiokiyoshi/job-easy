<div class="buttons">
  <%= link_to job_application_path(@resume.job_application), class: "d-flex text-decoration-none text-dark" do  %>
    <i class="fa-solid fa-arrow-left me-2"></i>
    <p>Back to <%= @resume.job_application.job_opening.title %> Job Page</p>
  <% end %>
  <div class="resume-buttons">
    <%= link_to "Apply for this job", job_application_path(@resume.job_application), data: {controller: "redirect", redirect_url_value: @resume.job_application.job_opening.job_url, action: "click->redirect#openUrl"}, class: "btn go-to-page-btn my-1"  %>
    <%= link_to "Ask Job Easy for suggestions", recommendations_resume_path(@resume), data: {turbo_method: "post"}, class: "btn go-to-page-btn my-1" %>
  </div>
</div>
<div class="row resume-workspace mt-5">
  <div class="<%= @advices.any? ? "col-lg-9" : "col-12" %>">
    <div id="onlyoffice-editor" style="width: 100%; height: 90vh;"></div>
  </div>

  <% if @advices.any? %>
    <div class="col-lg-3 mt-2">
      <div id="advices">
        <%= render partial: "advice", collection: @advices, as: :advice %>
      </div>
    </div>
  <% end %>
</div>


<script src="<%= ONLYOFFICE_CONFIG[:server_url] %>/web-apps/apps/api/documents/api.js"></script>
<script>
  document.addEventListener("turbo:load", function () {
    const config = <%= raw @editor_config.to_json %>;
    if (typeof DocsAPI !== "undefined") {
      new DocsAPI.DocEditor("onlyoffice-editor", config);
    } else {
      document.getElementById("onlyoffice-api-script")?.addEventListener("load", function() {
        new DocsAPI.DocEditor("onlyoffice-editor", config);
      });
    }
  });
</script>
