<% job_openings.each do |job_opening| %>
  <% application = applications_by_opening_id[job_opening.id] %>

  <article class="job-card <%= 'job-card--closed' if job_opening.closed? %>">
    <div class="job-card__panel">
      <div class="job-card__topline">
        <% if job_opening.company.logo.attached? %>
          <span class="job-card__logo" style="background-image: url(<%= cl_image_path(job_opening.company.logo.key, secure: true) %>)" aria-hidden="true"></span>
        <% else %>
          <span class="job-card__logo job-card__logo--fallback" aria-hidden="true"><%= job_opening.company.name.to_s.first&.upcase %></span>
        <% end %>

        <p class="job-card__company" title="<%= job_opening.company.name %>"><%= job_opening.company.name %></p>

        <div class="job-card__bookmark">
          <% if current_user %>
            <% if application %>
              <span class="job-card__save job-card__save--saved" aria-label="Job tracked" title="<%= application.status %>">
                <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
              </span>
            <% else %>
              <%= button_to job_opening_job_applications_path(job_opening), method: :post,
                    params: { bookmark: true, source: params[:source] }, class: "job-card__save", title: "Save job",
                    aria: { label: "Save #{job_opening.title}" } do %>
                <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
              <% end %>
            <% end %>
          <% else %>
            <%= link_to new_user_session_path, class: "job-card__save",
                  title: "Sign in to save this job",
                  aria: { label: "Sign in to save #{job_opening.title}" } do %>
              <i class="fa-solid fa-bookmark" aria-hidden="true"></i>
            <% end %>
          <% end %>
        </div>
      </div>

      <h2 class="job-card__title" title="<%= job_opening.title %>"><%= job_opening.title %></h2>
    </div>

    <div class="job-card__footer">
      <div class="job-card__facts">
        <p class="job-card__fact">
          <span class="job-card__yen-sack" aria-hidden="true">
            <i class="fa-solid fa-sack-dollar"></i>
            <span>¥</span>
          </span>
          <span><%= job_opening.salary.presence || "Not specified" %></span>
        </p>
        <p class="job-card__fact"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><span><%= job_opening.location.presence || "Not specified" %></span></p>
      </div>
      <span class="job-card__deadline <%= 'job-card__deadline--closed' if job_opening.closed? %>">
        <% if job_opening.closed? %>
          <i class="fa-solid fa-lock" aria-hidden="true"></i> Closed
        <% else %>
          <i class="fa-regular fa-calendar" aria-hidden="true"></i>
          <%= job_opening.deadline&.strftime("%b %-d, %Y") || "No deadline" %>
        <% end %>
      </span>
    </div>

    <%= link_to job_opening_path(job_opening), class: "job-card__details",
          aria: { label: "View #{job_opening.title} at #{job_opening.company.name}" } do %>
      <span class="visually-hidden">View job details</span>
    <% end %>
  </article>
<% end %>
