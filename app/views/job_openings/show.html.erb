<% content_for :title, "#{@job_opening.title} | JobEasy" %>

<% location = @job_opening.location %>
<% work_model = nil %>
<% employment_type = nil %>
<% salary = @job_opening.salary %>

<div class="job-show-page">
  <%= link_to job_openings_path, class: "page-back-link", aria: { label: "Back to job openings" } do %>
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6"/><path d="M9 12h10"/></svg>
    <span>Back to job openings</span>
  <% end %>

  <div class="job-show-layout">
    <main class="job-show-main">
      <header class="job-show-main__header">
        <span class="job-show-logo" aria-label="<%= @company.name %> logo" style="
          <%= @company.logo.attached? ? "background-image: url(#{cl_image_path(@company.logo.key, secure: true)})" : "background-color: rgba(0, 61, 150, 0.09)" %>">
        </span>

        <div class="job-show-main__heading">
          <div class="job-show-main__title-row">
            <h2><%= @job_opening.title %></h2>
            <% if @job_opening.source.present? %>
              <span class="job-show-source"><%= @job_opening.source %></span>
            <% end %>
          </div>
          <p><%= @company.name %></p>

          <div class="job-show-highlights" aria-label="Job highlights">
            <span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <%= location.presence || "Location not available" %>
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="2"/><path d="M8 6V4h8v2M3 11h18"/></svg>
              <%= employment_type.presence || "Employment type not available" %>
            </span>
            <span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <%= @job_opening.deadline.present? ? "Apply by #{@job_opening.deadline.strftime('%b %-d, %Y')}" : "Deadline not available" %>
            </span>
          </div>
        </div>
      </header>

      <section class="job-show-description">
        <h2>Job description</h2>
        <% if @job_opening.content.present? %>
          <%= simple_format(@job_opening.content) %>
        <% else %>
          <p class="job-show-unavailable">No job description is available.</p>
        <% end %>
      </section>
    </main>

    <aside class="job-show-sidebar">
      <section class="job-details-card">
        <header>
          <p>Overview</p>
          <h2>Job details</h2>
        </header>

        <dl class="job-details-list">
          <div><dt>Company</dt><dd><%= @company.name %></dd></div>
          <div><dt>Location</dt><dd class="<%= "job-details-list__unavailable" if @job_opening.location.blank? %>"><%= @job_opening.location.presence || "Not available" %></dd></div>
          <div><dt>Work model</dt><dd class="<%= "job-details-list__unavailable" "Not available" %></dd></div>
          <div><dt>Employment type</dt><dd class="<%= "job-details-list__unavailable" if @job_opening.employment_type.blank? %>"><%= @job_opening.employment_type.presence || "Not available" %></dd></div>
          <div><dt>Salary</dt><dd class="<%= "job-details-list__unavailable" if @job_opening.salary.blank? %>"><%= @job_opening.salary.presence || "Not available" %></dd></div>
          <div>
            <dt>Deadline</dt>
            <dd class="<%= "job-details-list__unavailable" if @job_opening.deadline.blank? %>"><%= @job_opening.deadline&.strftime("%B %-d, %Y") || "Not available" %></dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd><span class="job-status job-status--<%= @job_opening.closed? ? "closed" : "open" %>"><%= @job_opening.closed? ? "Closed" : "Open" %></span></dd>
          </div>
          <div>
            <dt>Source</dt>
            <dd class="<%= "job-details-list__unavailable" if @job_opening.source_url.blank? %>">
              <% if @job_opening.source_url.present? %>
                <%= link_to "View source", @job_opening.source_url, target: "_blank", rel: "noopener noreferrer" %>
              <% else %>
                Not available
              <% end %>
            </dd>
          </div>
        </dl>

        <div class="job-company-about">
          <h3>About <%= @company.name %></h3>
          <p><%= @company.description.presence || "No company description is available." %></p>
        </div>
      </section>

      <div class="job-show-actions">
        <% if @job_application.present? %>
          <%= link_to "Go to application", job_application_path(@job_application), class: "job-show-button job-show-button--primary" %>
        <% else %>
          <%= link_to "Save job", job_opening_job_applications_path(@job_opening), data: { turbo_method: :post }, class: "job-show-button job-show-button--primary" %>
        <% end %>

        <% if @job_opening.job_url.present? %>
          <%= link_to "Visit job page", @job_opening.job_url, target: "_blank", rel: "noopener noreferrer", class: "job-show-button job-show-button--secondary" %>
        <% else %>
          <span class="job-show-button job-show-button--disabled" aria-disabled="true">Job page not available</span>
        <% end %>
      </div>
    </aside>
  </div>
</div>
