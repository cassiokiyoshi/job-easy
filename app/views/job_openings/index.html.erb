<div class="job-openings-page">
  <div class="head">
    <h1>Job Openings</h1>
    <span class="job-openings-count"><%= @job_openings.size %></span>
  </div>

  <div class="job-openings-grid">
    <%= render "job_openings/job_cards", job_openings: @job_openings%>
    <%= render "job_openings/job_cards", job_openings: @job_openings_closed %>
  </div>
</div>
